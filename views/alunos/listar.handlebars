<div class="topo-lista">
  <h2>Alunos cadastrados</h2>
  <a class="btn btn-verde" href="/alunos/novo">+ Novo aluno</a>
</div>

{{#if alunos.length}}
<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Nome</th>
      <th>RA</th>
      <th>E-mail</th>
      <th>Acoes</th>
    </tr>
  </thead>
  <tbody>
    {{#each alunos}}
    <tr>
      <td>{{this.id}}</td>
      <td>{{this.nome}}</td>
      <td>{{this.ra}}</td>
      <td>{{this.email}}</td>
      <td class="acoes">
        <a href="/alunos/{{this.id}}">Ver</a>
        <a href="/alunos/{{this.id}}/editar">Editar</a>
        <form action="/alunos/{{this.id}}?_method=DELETE" method="POST" onsubmit="return confirm('Excluir este aluno?');">
          <button type="submit" class="btn-link-excluir">Excluir</button>
        </form>
      </td>
    </tr>
    {{/each}}
  </tbody>
</table>
{{else}}
<p>Nenhum aluno cadastrado ainda.</p>
{{/if}}
